# Vite inlines import.meta.env.* at BUILD time, but a browser has no environment
# to read, so the API URL cannot be a normal runtime variable.
#
# Instead we bake in a placeholder that the stack 'webapp' wrapper rewrites when
# the container starts: apply-runtime-env.sh finds STACK_RUNTIME_ENV_API_URL in
# the built assets and replaces it with the value of $API_URL. That keeps the
# image environment-independent — build once, deploy anywhere.
#
# Consequence: a local production build (`npm run build && npm run preview`) will
# contain the literal placeholder rather than a usable URL. Use `npm start` (the
# dev server, which reads VITE_API_URL from the environment normally) for local
# development.
VITE_API_URL=STACK_RUNTIME_ENV_API_URL
